{
  "name": "triple-s-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/runtime.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "node scripts/dev.mjs --preview",
    "test:stage1": "playwright test",
